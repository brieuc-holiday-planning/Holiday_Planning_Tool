DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
